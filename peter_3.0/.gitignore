# --- secrets -----------------------------------------------------------------
.env
.env.*
!.env.example

# --- OAuth tokens and credentials --------------------------------------------
# google_token.json holds a live refresh token for the calendar. Treat it as a
# password, not a cache.
*token.json
credentials.json
client_secret*.json

# --- runtime state ------------------------------------------------------------
data/
*.db
*.db-journal
*.sqlite3
*.log
audit.jsonl

# --- downloaded models (large, and reproducible) ------------------------------
*.onnx
*.onnx.json
*.tflite
models/
voices/

# --- browser profile (phase 3) ------------------------------------------------
browser_profile/

# --- ADB / Android Platform Tools (phone integration) -------------------------
# A downloaded third-party tool, not project source. Redistribute the download
# link (developer.android.com/tools/releases/platform-tools), not the binary.
mobile dev/

# --- python -------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
