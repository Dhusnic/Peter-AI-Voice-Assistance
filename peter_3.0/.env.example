# Peter 3.0 — SECRETS ONLY.
#
# Everything else — models, voice, wake word, policy, integrations — lives in
# config/config.yml, which is committed to git. Nothing in this file ever is.
#
# Copy to .env and fill in. Leave a section blank to leave that feature off;
# Peter starts fine without it and says so when asked.

# ------------------------------------------------------- LLM providers
# At least ONE of these is required. Peter runs on whichever is selected by
# agent.provider in config/config.yml, and can be switched by voice at runtime
# if more than one key is present.
#
# Claude   https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# GPT      https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Gemini   https://aistudio.google.com/apikey   (GOOGLE_API_KEY also accepted)
GEMINI_API_KEY=

# ------------------------------------------------------- email (IMAP + SMTP)
# Uses an app password, not your account password. Gmail requires 2-step
# verification to be on, then: myaccount.google.com > Security > App passwords.
# IMAP must also be enabled in Gmail settings under "Forwarding and POP/IMAP".
#
# Why not the Gmail API: its scopes are "restricted", which caps personal
# projects at a refresh token that expires every 7 days. An app password does
# not expire.
PETER_MAIL_ADDRESS=
PETER_MAIL_APP_PASSWORD=

# --------------------------------------------- google calendar + tasks (OAuth)
# console.cloud.google.com > APIs & Services > Credentials
#   > Create credentials > OAuth client ID > Application type: Desktop app
# Enable the "Google Calendar API" and "Google Tasks API" for the project.
#
# Then set the OAuth consent screen to "In Production" — in "Testing" status
# Google expires your refresh token after 7 days. Calendar and Tasks scopes are
# only "sensitive", so this needs no security audit; you will see an
# "unverified app" warning once, which you can click through.
#
# Finally run: python -m peter.main --google-auth
#
# Also covers Contacts (read-only) and Drive (read-only) — same client,
# same auth. If this was already authorised before those scopes existed,
# re-run --google-auth once; Contacts/Drive calls 403 until you do.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ------------------------------------------- google keep (unofficial, opt-in)
# NOT the OAuth setup above. There is no official Keep API for a personal
# Google account, so this uses gkeepapi, which authenticates with a master
# token — full account-wide access, not a scoped, revocable grant. Read
# docs/USER_MANUAL.md's Keep section and set integrations.keep.enabled: true
# in config.yml before filling these in. Obtain the token following
# gkeepapi's own documented method: github.com/kiwiz/gkeepapi
GOOGLE_KEEP_EMAIL=
GOOGLE_KEEP_MASTER_TOKEN=

# ------------------------------------------------------ telegram (your phone)
# Lets you talk to Peter from your phone, and lets every proactive nudge
# (reminders, meeting prep, inbox digest, price alerts, CI failures, finished
# focus sessions) reach you when you are away from the machine.
#
#   1. Open Telegram and message @BotFather
#   2. Send /newbot and follow the prompts
#   3. Paste the token it gives you below
#   4. Run: python -m peter.main --telegram-setup
#   5. Put the chat id it prints into config/config.yml under
#      integrations.telegram.allowed_chat_ids
#
# The token is the whole security boundary here: anyone holding it can send
# messages as your bot. The allowlist is what stops a stranger who finds the
# bot from reaching Peter - an unknown chat gets no reply at all.
TELEGRAM_BOT_TOKEN=

# ----------------------------------------------------- things that are NOT keys
# Two integrations deliberately have no secret in this file, because they carry
# their own credentials and Peter should never hold a copy:
#
#   GitHub   the `gh` CLI keeps your token in the OS keychain. Install it from
#            cli.github.com and run: gh auth login
#   Phone    ADB authorises per-machine on the handset itself. Enable USB
#            debugging, plug in, and accept the prompt on the phone.

# --------------------------------------------------------------- overrides
# Any config.yml value can be overridden here for one run, by spelling out its
# path with double underscores. Useful for debugging; not for normal config.
#   PETER__APP__LOG_LEVEL=DEBUG
#   PETER__AGENT__MODEL=claude-sonnet-5
#   PETER__VOICE__TTS__ENGINE=edge
