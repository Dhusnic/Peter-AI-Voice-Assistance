# Peter 3.0 — SECRETS ONLY.
#
# Everything else — models, voice, wake word, policy, integrations — lives in
# config/config.yml, which is committed to git. Nothing in this file ever is.
#
# Copy to .env and fill in. Leave a section blank to leave that feature off;
# Peter starts fine without it and says so when asked.

# ------------------------------------------------------- LLM providers
# At least ONE of these is required. Peter runs on whichever is selected by
# agent.provider in config/config.yml, and can be switched by voice at runtime
# if more than one key is present.
#
# Claude   https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# GPT      https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Gemini   https://aistudio.google.com/apikey   (GOOGLE_API_KEY also accepted)
GEMINI_API_KEY=

# ------------------------------------------------------- email (IMAP + SMTP)
# Uses an app password, not your account password. Gmail requires 2-step
# verification to be on, then: myaccount.google.com > Security > App passwords.
# IMAP must also be enabled in Gmail settings under "Forwarding and POP/IMAP".
#
# Why not the Gmail API: its scopes are "restricted", which caps personal
# projects at a refresh token that expires every 7 days. An app password does
# not expire.
PETER_MAIL_ADDRESS=
PETER_MAIL_APP_PASSWORD=

# --------------------------------------------- google calendar + tasks (OAuth)
# console.cloud.google.com > APIs & Services > Credentials
#   > Create credentials > OAuth client ID > Application type: Desktop app
# Enable the "Google Calendar API" and "Google Tasks API" for the project.
#
# Then set the OAuth consent screen to "In Production" — in "Testing" status
# Google expires your refresh token after 7 days. Calendar and Tasks scopes are
# only "sensitive", so this needs no security audit; you will see an
# "unverified app" warning once, which you can click through.
#
# Finally run: python -m peter.main --google-auth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --------------------------------------------------------------- overrides
# Any config.yml value can be overridden here for one run, by spelling out its
# path with double underscores. Useful for debugging; not for normal config.
#   PETER__APP__LOG_LEVEL=DEBUG
#   PETER__AGENT__MODEL=claude-sonnet-5
#   PETER__VOICE__TTS__ENGINE=edge
